@startuml
skinparam componentStyle rectangle
left to right direction

actor "BIM-специалист / проектировщик" as User
component "ContextFilter.UI\nWPF / ViewModels" as UI
component "ContextFilter.Application\nСценарии / сервисы" as App
component "ContextFilter.Domain\nМодели / семантика" as Domain
component "ContextFilter.Infrastructure\nJSON-хранение / журналы" as Infra
component "ContextFilter.Revit\nПлагин / ExternalEvent / Revit API" as RevitPlugin
component "Autodesk Revit 2025\nДокумент / вид / элементы / выделение" as RevitHost

User --> UI : условия фильтра / действия
UI --> App : сценарии использования
UI --> Domain : модели Domain
App --> Domain : семантические модели
Infra --> App : порты / хранение
Infra --> Domain : сохраняемые модели
RevitPlugin --> UI : интеграция со средой
RevitPlugin --> Infra
RevitPlugin --> App
RevitPlugin --> Domain
RevitPlugin --> RevitHost : сбор / транзакции / штатные действия
RevitHost --> RevitPlugin : состояние документа / события

note right of Domain
Не зависит от Revit,
WPF и физического хранения.
end note

note bottom of RevitHost
Источник истины для документа,
элементов, видов, выделения
и штатного состояния API.
end note
@enduml
