@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment center

actor "Пользователь" as User
rectangle "ContextFilter.UI" {
  rectangle "MainPaneView /\nMainFilterWindow" as View
  rectangle "MainPaneViewModel" as MainVM
  rectangle "Специализированные ViewModel" as VMs
  rectangle "Состояние UI / сообщения" as State
}
rectangle "ContextFilter.Application" {
  rectangle "Сценарии / сервисы" as App
  interface "IRevitGateway / порты" as Ports
}
rectangle "Адаптеры ContextFilter.Revit /\nInfrastructure" as Adapters

User --> View : взаимодействие
View --> MainVM : команда / binding
MainVM --> VMs : координация представления
VMs --> MainVM : выбранное состояние UI
MainVM --> App : запустить сценарий
App --> Ports : внешняя возможность
Ports --> Adapters : вызов адаптера
Adapters --> Ports : ответ / ошибка
Ports --> App
App --> MainVM : результат
MainVM --> State : обновить
State --> View : отобразить

note right of View
Первичное связывание данных
не является намерением пользователя.
Побочные действия в этот момент подавлены.
end note

note bottom of State
Производное состояние конкретного документа
сбрасывается при смене документа.
end note
@enduml
