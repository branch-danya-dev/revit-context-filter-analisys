@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultTextAlignment center

rectangle "UI / Application" as Caller
interface "IRevitGateway" as Port
rectangle "ContextFilter.Revit" {
  rectangle "RevitExternalEventDispatcher" as GW
  queue "RevitRequestQueue" as Queue
  rectangle "ExternalEvent" as EE
  rectangle "ContextFilterExternalEventHandler" as Handler
  rectangle "RevitRequestDispatcher" as Dispatcher
  rectangle "Сервисы сбора / параметров / действий" as Services
  rectangle "ContextCoordinationService" as Coord
}
rectangle "Autodesk Revit" {
  rectangle "Document / View / UIDocument" as Revit
  rectangle "События Revit\nViewActivated / Idling / Document*" as Events
}

Caller --> Port : асинхронный запрос
Port --> GW
GW --> Queue : поставить в очередь
Queue --> EE : Raise()
EE --> Handler : выполнить в потоке Revit
Handler --> Dispatcher
Dispatcher --> Services
Services --> Revit : чтение / изменение
Revit --> Services : результат / ошибка
Services --> Dispatcher
Dispatcher --> Handler
Handler --> GW : завершить ответ
GW --> Port
Port --> Caller

Events --> Coord : сведения среды
Coord --> Queue : обновить / перестроить при необходимости
Coord --> Caller : состояние / прогресс

note right of EE
Доступ к Revit API контролирует среда.
Асинхронный вызывающий код не означает
потокобезопасный доступ к API.
end note

note bottom of Services
Смысл Domain здесь не переопределяется.
Слой реализует его с учётом ограничений Revit.
end note
@enduml
