@startuml
left to right direction
skinparam packageStyle rectangle

actor "Пользователь" as User
rectangle "Autodesk Revit" as Revit
rectangle "ContextFilter" as CF {
  rectangle "Рабочий контекст" as Context
  rectangle "Поиск элементов" as Discovery
  rectangle "Параметрическая фильтрация" as Filtering
  rectangle "Повторно используемые пресеты" as Presets
  rectangle "Действия над найденным набором" as Actions
}

User --> CF
Revit --> Context : исходный документ / вид / выделение
Context --> Discovery
Discovery --> Filtering
Filtering --> Actions
Filtering --> Presets
Presets --> Filtering
Actions --> Revit : выделение / временная видимость / штатный фильтр

rectangle "Вне границы" as OOS {
  rectangle "Изменение геометрии"
  rectangle "Массовое редактирование параметров"
  rectangle "Удаление элементов"
  rectangle "Задача корректировки DWG"
}

CF .. OOS : не принадлежит ContextFilter
@enduml
