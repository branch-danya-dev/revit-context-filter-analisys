@startuml
skinparam monochrome true
skinparam shadowing false
skinparam packageStyle rectangle

package "Контекст" {
  enum CollectionScope
  class CollectedContext
  class ContextNode
  class ElementSnapshot
}
package "Параметры" {
  class ParameterKey
  class ParameterValue
}
package "Фильтрация" {
  class FilterDefinition
  class FilterGroup
  class FilterCondition
}
package "Пресеты" {
  class PresetDefinition
  enum PresetKind
}
package "Результаты" {
  class FilterResult
  enum SelectionAction
  enum VisibilityAction
  enum NativeFilterAction
}
CollectionScope --> CollectedContext
CollectionScope --> FilterDefinition
CollectedContext --> ContextNode
CollectedContext --> ElementSnapshot
ElementSnapshot --> ParameterKey
ElementSnapshot --> ParameterValue
FilterDefinition --> FilterGroup
FilterGroup --> FilterGroup
FilterGroup --> FilterCondition
FilterCondition --> ParameterKey
PresetDefinition --> PresetKind
PresetDefinition --> CollectionScope
PresetDefinition --> FilterGroup
FilterDefinition ..> FilterResult : вычисляется над контекстом
FilterResult ..> SelectionAction
FilterResult ..> VisibilityAction
FilterResult ..> NativeFilterAction
@enduml
